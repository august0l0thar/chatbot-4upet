# Gemini
GOOGLE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Modelos usados no notebook original
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Configuração da busca RAG
RAG_THRESHOLD=0.70
RAG_MATCH_COUNT=5

# Para Flutter Web durante desenvolvimento pode ficar "*".
# Em produção, prefira informar os domínios separados por vírgula.
CORS_ORIGINS=*
